---
import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ArchitectureStack from '~/components/ArchitectureStack.astro';
import EarlyAccessForm from '~/components/EarlyAccessForm.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

import { SITE } from 'astrowind:config';
import { AUTHOR, DEMO_URL, DOCS_URL, GITHUB_URL, INSTALL_COMMAND, MODIFIED_DATE, PUBLISHED_DATE, SHOW_GITHUB_LINKS } from '~/site';

const DESCRIPTION =
  'Edit, maintain, and optimize your website with AI. Describe changes in plain language and agents update content, components, and SEO metadata. Next.js and Astro today. Self-hostable, bring your own LLM keys.';

const metadata = {
  title: 'Avocado Studio: edit, maintain, and optimize your site with AI',
  ignoreTitleTemplate: true,
  description: DESCRIPTION,
  canonical: SITE.site,
  openGraph: {
    url: SITE.site,
    type: 'website',
  },
};

// Kept as one @graph so Organization/WebSite (emitted site-wide by the layout's
// counterpart in navigation) and the page-scoped nodes cross-reference by @id.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.site}/#organization`,
      name: 'Avocado Studio',
      url: SITE.site,
      logo: `${SITE.site}/logo.svg`,
      sameAs: SHOW_GITHUB_LINKS ? [GITHUB_URL, AUTHOR.url] : [AUTHOR.url],
      founder: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.site}/#website`,
      url: SITE.site,
      name: 'Avocado Studio',
      publisher: { '@id': `${SITE.site}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.site}/#software`,
      name: 'Avocado Studio',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Web',
      description: DESCRIPTION,
      url: SITE.site,
      author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
      publisher: { '@id': `${SITE.site}/#organization` },
      datePublished: PUBLISHED_DATE,
      dateModified: MODIFIED_DATE,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.site}/#webpage`,
      url: SITE.site,
      name: 'Avocado Studio: edit, maintain, and optimize your site with AI',
      isPartOf: { '@id': `${SITE.site}/#website` },
      about: { '@id': `${SITE.site}/#software` },
      datePublished: PUBLISHED_DATE,
      dateModified: MODIFIED_DATE,
      author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
    },
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <!-- Hero ************************ -->

  {/* Hand-built rather than a stock Hero widget so the demo sits beside the
      copy above the fold on desktop, and so the mobile order can be chosen
      deliberately: headline, the one-line promise, the video, and only then
      the actions and small print. A stacked hero pushes the demo a full
      screen down on a phone, which is the one thing it must not do. */}
  {/* Gutters inside the max-w-7xl box, not outside it — `px-4 md:px-6` on the
      container itself, exactly as `WidgetWrapper`, the header and the footer do
      it. With the padding outside, this section's content sat flush against the
      1280px box while everything else on the page was inset 24px inside it: the
      headline and the demo hung a notch further out than the logo above them
      and every section below. Identical below 1328px, where the box is not yet
      capped; visible on every wider screen. */}
  <section class="pt-8 pb-12 sm:pt-12 lg:pt-16 lg:pb-20">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-y-6 px-4 sm:gap-y-8 md:px-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12 lg:gap-y-8"
    >
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:self-start">
        <h1
          class="display font-heading text-heading text-[2.25rem] leading-[1.08] font-bold tracking-tighter text-balance sm:text-5xl lg:text-[2.875rem] lg:leading-[1.07] xl:text-[3.125rem]"
        >
          Edit, maintain, optimize<br /><span class="text-primary">your website with AI.</span>
        </h1>

        <p class="text-muted mt-4 max-w-xl text-lg leading-8 sm:mt-6">
          Not another way to vibe-code a new site: this runs the one you have. Describe a change and an agent edits
          content, images and SEO in your own components, then publishes to your CMS. Next.js and Astro today.
        </p>

        {/* Whose it is, before anything else. The line above says what it does;
            this says what stays yours, which is the actual pitch. On a phone only
            the four labels show, in a wrapped row, so the video is not pushed a
            screen down; from `sm` each label gets its qualifier. */}
        <ul class="mt-5 flex max-w-xl flex-wrap gap-x-5 gap-y-2 sm:mt-6 sm:grid sm:grid-cols-[max-content_max-content] sm:gap-x-8 sm:gap-y-2">
          {
            [
              ['Your site', 'no migration'],
              ['Your components', 'design system intact'],
              ['Your CMS', 'Sanity, Storyblok & more'],
              ['Your AI keys', 'Claude, GPT or Gemini'],
            ].map(([label, detail]) => (
              <li class="flex items-start gap-2 text-sm leading-6">
                <Icon name="tabler:check" class="text-primary mt-1 h-4 w-4 flex-none" aria-hidden="true" />
                <span>
                  <span class="text-heading font-semibold">{label}</span>
                  <span class="text-muted hidden sm:inline"> — {detail}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="demo" class="lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1 lg:self-start">
        <figure
          class="border-line bg-sunk overflow-hidden rounded-xl border shadow-[0_1px_2px_rgba(22,36,26,0.05),0_12px_32px_-12px_rgba(22,36,26,0.18)] dark:shadow-none"
        >
          {/* 16/9, matching the recording — the old box was 1280/702 and would
              crop the top and bottom off this one. The ratio is on the wrapper
              so the space is reserved before a single byte of video arrives. */}
          <div class="relative aspect-video w-full">
            {/*
              Above the fold and autoplaying, so it has to be cheap: 1.2MB of
              VP9 (1.6MB of H.264 for Safari), `preload="none"` so the poster is
              all that loads until playback actually starts, and `width`/`height`
              to keep the intrinsic size known. Sources are cheapest-first; a
              browser takes the first type it can decode and never requests the
              other. Muted + playsinline are what make autoplay legal on iOS.
            */}
            <video
              id="hero-demo"
              class="absolute inset-0 h-full w-full object-cover"
              width="1280"
              height="720"
              autoplay
              muted
              loop
              playsinline
              controls
              preload="none"
              poster="/demo-2026-09-v2-poster.jpg"
              disablepictureinpicture
              aria-label="Avocado Studio demo: editing a page by describing the change"
            >
              <source src="/demo-2026-09-v2.webm" type="video/webm" />
              <source src="/demo-2026-09-v2.mp4" type="video/mp4" />
            </video>
          </div>
        </figure>

        {/* A looping hero is decoration, and the one thing `autoplay` cannot
            express in markup is "unless the visitor asked for less motion".
            Inline and immediately after the element so it runs during parse,
            before playback starts: they get the poster and the controls, and
            the video bytes are never fetched at all. */}
        <script is:inline>
          (function () {
            var v = document.getElementById('hero-demo');
            if (v && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
              v.removeAttribute('autoplay');
              v.removeAttribute('loop');
              v.pause();
            }
          })();
        </script>

      </div>

      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-2 lg:self-start">
        <div class="flex flex-wrap items-center gap-3">
          {
            SHOW_GITHUB_LINKS && (
              <Button
                variant="primary"
                href={GITHUB_URL}
                target="_blank"
                rel="noopener"
                icon="tabler:brand-github"
                class="py-2.5 text-[0.9375rem] sm:py-3 sm:text-base"
              >
                View on GitHub
              </Button>
            )
          }
          <Button
            variant={SHOW_GITHUB_LINKS ? 'secondary' : 'primary'}
            href={DEMO_URL}
            target="_blank"
            rel="noopener"
            class="py-2.5 text-[0.9375rem] sm:py-3 sm:text-base"
          >
            Try the live demo
          </Button>
          <Button variant="secondary" href={DOCS_URL} class="py-2.5 text-[0.9375rem] sm:py-3 sm:text-base">
            Read the docs
          </Button>
        </div>

        <p class="text-muted mt-6 max-w-md text-sm leading-6">
          Free to use and self-hostable — no waitlist, no sign-up, no seat count. On your own machine it is one
          command:{' '}
          <a href="#quick-start" class="text-link decoration-line-strong hover:decoration-primary font-mono whitespace-nowrap underline underline-offset-4 transition-colors"
            >{INSTALL_COMMAND}</a
          >.
        </p>

      </div>
    </div>
  </section>

  <!-- Capabilities **************** -->

  <Features
    id="capabilities"
    tagline="Capabilities"
    title="Built for the modern web."
    columns={3}
    items={[
      {
        title: 'AI-assisted editing',
        description:
          'Agents update real website content: components, metadata, and publishing steps. Not just generated paragraphs.',
        icon: 'tabler:wand',
      },
      {
        title: 'Live preview',
        description:
          'See changes instantly in your own application while agents modify content and layouts in real time.',
        icon: 'tabler:eye',
      },
      {
        title: 'Works with your stack',
        description:
          'Use your existing CMS, DAM, design system, frontend, and AI providers. No proprietary lock-in.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Multi-model',
        description:
          'Bring your own models from Anthropic, OpenAI, or Gemini for text, images, and multimodal work. Route different tasks to different models.',
        icon: 'tabler:topology-star-3',
      },
      {
        title: 'Self-hostable',
        description: 'Deploy on your own infrastructure with full control over data, APIs, prompts, and integrations.',
        icon: 'tabler:server-2',
      },
      {
        title: 'Connected workflows',
        description: 'Link editing, approvals, publishing, media, and localization into one workflow you control.',
        icon: 'tabler:route',
      },
    ]}
  />

  <!-- How it works **************** -->

  <Steps
    id="how-it-works"
    tagline="How it works"
    title="Describe it. Review it. Ship it."
    subtitle="Nothing reaches production because an agent decided it should. Every change passes through a preview you sign off on."
    items={[
      {
        title: 'Describe the change',
        description: 'Say what you want in plain language — no schema spelunking, no ticket for a one-line copy fix.',
        icon: 'tabler:message-2',
      },
      {
        title: 'Agents do the work',
        description:
          'Content, components, and SEO metadata are updated in place, and media assets are created or edited with GenAI.',
        icon: 'tabler:wand',
      },
      {
        title: 'Preview before anything ships',
        description:
          'See the result in your own application, with your components, schema, and review rules intact.',
        icon: 'tabler:eye-check',
      },
      {
        title: 'Publish on your own terms',
        description:
          'Approvals and publishing run through the pipeline you already have, on infrastructure you control.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- Architecture **************** -->

  <Content
    id="architecture"
    tagline="Architecture"
    title="An open layer between AI and your stack."
    subtitle="Avocado Studio sits between AI models and your existing content systems. Instead of replacing your stack, it coordinates work across it."
    columns={2}
    items={[
      { title: 'Websites' },
      { title: 'Headless CMSs' },
      { title: 'DAMs' },
      { title: 'Design systems' },
      { title: 'Localization tools' },
      { title: 'Publishing pipelines' },
    ]}
  >
    <Fragment slot="image">
      <ArchitectureStack />
    </Fragment>

    <Fragment slot="content">
      <p>Next.js and Astro today, with your own components doing the rendering. Extend to the rest of your stack from there.</p>
    </Fragment>
  </Content>

  <!-- Use cases ******************* -->

  <Features3
    id="use-cases"
    tagline="Use cases"
    title="What Avocado is built for."
    columns={2}
    items={[
      {
        title: 'Edit your website with AI',
        description:
          'Change website content in plain language while keeping your components, schema, and review rules intact.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Marketing operations',
        description: 'Coordinate publishing workflows across CMS, DAM, localization, and approval systems.',
        icon: 'tabler:calendar-stats',
      },
      {
        title: 'Images and copy together',
        description: 'Generate and edit images with Claude, OpenAI, or Gemini alongside your structured content.',
        icon: 'tabler:photo-edit',
      },
      {
        title: 'Your own editorial stack',
        description:
          'Build AI editing into your own workflows instead of buying a heavyweight enterprise platform.',
        icon: 'tabler:tools',
      },
    ]}
  />

  <!-- Developer experience ******** -->

  <WidgetWrapper id="developers">
    <Headline
      tagline="Developer experience"
      title="Built for developers and platform teams."
      classes={{ container: 'max-w-3xl', title: 'text-3xl md:text-4xl' }}
    />
    <ul class="mx-auto grid max-w-5xl gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          'API-first architecture',
          'Git-friendly workflows',
          'Self-hostable deployment',
          'Extensible adapters',
          'Streaming workflows',
          'Bring your own AI providers',
          'Works alongside existing CMS platforms',
          'Apache-2.0 packages on npm',
        ].map((item, index) => (
          <li class="border-line text-page flex items-baseline gap-3 border-b py-3 text-sm">
            <span aria-hidden="true" class="label tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <!-- Positioning ***************** -->

  {/* WidgetWrapper's isDark paints bg-dark but turns it transparent in dark mode,
      on the assumption the whole page is already dark. Here the band is a
      deliberate change of ground either way, so give it its own surface: the
      deep brand green on paper, one step lighter than the page in dark. */}
  <WidgetWrapper isDark containerClass="max-w-4xl text-center py-16 md:py-24 lg:py-28">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#16241a] dark:bg-[#1e2519]"></div>
    </Fragment>
    <h2 class="display font-heading text-3xl leading-tight font-bold tracking-tighter text-balance text-white md:text-5xl">
      Not another CMS.<br />Not another AI writing tool.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-7 text-white/75">
      Avocado Studio is an open AI layer for editing and publishing across the tools you already use.
    </p>
    <p class="mx-auto mt-4 max-w-xl leading-7 text-white/60">
      It helps teams edit websites and publish content with AI agents while keeping their existing stack,
      infrastructure, and controls intact.
    </p>
  </WidgetWrapper>

  <!-- Quick start ***************** -->

  <QuickStart
    id="quick-start"
    tagline="Run it yourself"
    title="One command to a working editor."
    subtitle="Scaffolds a site, the editor and the AI layer in one project, then starts it with <code>npm run dev</code>."
    commands={[INSTALL_COMMAND]}
    items={[
      { title: 'Node 22+', description: 'The only prerequisite.', icon: 'tabler:server-2' },
      {
        title: 'Your own key',
        description: 'Anthropic, OpenAI or Gemini. Without one the editor still opens; chat asks for a key.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Or your own site',
        description: 'Wire it into an existing Next.js or Astro project instead. <a class="text-link underline" href="https://docs.avocadostudio.dev">See the docs</a>.',
        icon: 'tabler:route',
      },
    ]}
  />

  <!-- FAQs ************************ -->

  <FAQs
    id="faqs"
    tagline="FAQs"
    title="Questions worth answering up front."
    schema
    items={[
      {
        title: 'Is it really open source?',
        description:
          'Every package is Apache-2.0 and published to npm, where each one ships its readable source — the planner prompts included. The GitHub repository itself is not public yet. There is no seat count and no six-figure platform contract.',
      },
      {
        title: "Do I have to send my content to someone else’s cloud?",
        description:
          'No. Avocado Studio is self-hostable: deploy it on your own infrastructure with full control over data, APIs, prompts, and integrations.',
      },
      {
        title: 'Which AI models does it use?',
        description:
          'Whichever you bring. Use your own keys for Anthropic, OpenAI, or Gemini across text, images, and multimodal work, and route different tasks to different models.',
      },
      {
        title: 'Will it replace my CMS?',
        description:
          'No — it coordinates work across the stack you already have. Your CMS, DAM, design system, frontend, and AI providers stay where they are.',
      },
      {
        title: 'Can an agent publish something without me seeing it?',
        description:
          'No. You get a preview before anything ships, and publishing runs through your own approval and release pipeline.',
      },
      {
        title: 'Which frameworks does it support?',
        description:
          'Next.js and Astro today. The Astro integration renders your own .astro components — no React islands, nothing ported. The architecture is an open layer between AI and your stack, so it is not tied to one framework, and more will follow.',
      },
    ]}
  />

  <!-- Contact ********************* -->

  {/* `id="contact"`, not `early-access`: the form is a way to reach us, not a
      queue to join. The anchor is what the header button and the footer link
      land on, and a URL ending /#early-access argues with the sentence above
      it. The API route and its table keep their old names — those are ours,
      and renaming them buys nothing a visitor can see. */}
  <WidgetWrapper id="contact" containerClass="max-w-4xl">
    <Headline
      title="AI editing you actually own."
      subtitle="Not rented from a platform, not locked behind a seat count. Run it on your own infrastructure with your own model keys, free. Nothing here is a waiting list — leave an address if you would like a hand onboarding your site, or just start with the docs."
      classes={{ container: 'max-w-2xl', title: 'text-3xl md:text-4xl' }}
    />

    <div class="border-line bg-page mx-auto max-w-xl rounded-xl border p-6 sm:p-8">
      <EarlyAccessForm />
    </div>

    <div class="mx-auto mt-8 flex max-w-xl items-center gap-4">
      <span aria-hidden="true" class="bg-line h-px flex-1"></span>
      <span class="label">or</span>
      <span aria-hidden="true" class="bg-line h-px flex-1"></span>
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      {
        SHOW_GITHUB_LINKS && (
          <Button variant="secondary" href={GITHUB_URL} target="_blank" rel="noopener" icon="tabler:brand-github">
            View on GitHub
          </Button>
        )
      }
      <Button variant="secondary" href={DEMO_URL} target="_blank" rel="noopener">Try the live demo</Button>
      <Button variant="secondary" href={DOCS_URL}>Read the docs</Button>
    </div>
  </WidgetWrapper>
</Layout>
