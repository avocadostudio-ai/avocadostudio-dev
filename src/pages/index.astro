---
import Layout from '~/layouts/PageLayout.astro';

import Features from '~/components/widgets/Features.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import QuickStart from '~/components/widgets/QuickStart.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import ArchitectureStack from '~/components/ArchitectureStack.astro';
import EarlyAccessForm from '~/components/EarlyAccessForm.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import { Icon } from 'astro-icon/components';

import { SITE } from 'astrowind:config';
import {
  AUTHOR,
  DEMO_URL,
  DEMO_YOUTUBE_ID,
  DOCS_URL,
  GITHUB_URL,
  INSTALL_COMMAND,
  MODIFIED_DATE,
  PRODUCT_HUNT,
  PUBLISHED_DATE,
  SHOW_GITHUB_LINKS,
} from '~/site';

const POSTER_PATH = '/demo-2026-09-v2-poster.jpg';

// Nobody searches for "avocado". The title and description lead with what
// people do type — "AI website editor", "Next.js", "Astro", "headless CMS",
// "open source" — and the brand goes last, where the result's site name
// already repeats it. The description stays under ~160 characters so the
// snippet is not cut mid-claim.
const TITLE = 'Open-source AI website editor for Next.js & Astro | Avocado Studio';
const DESCRIPTION =
  'Edit your Next.js or Astro site with AI. Describe a change; an agent updates copy, images and SEO meta in your own components and headless CMS. Open source.';

const metadata = {
  title: TITLE,
  ignoreTitleTemplate: true,
  description: DESCRIPTION,
  canonical: SITE.site,
  openGraph: {
    url: SITE.site,
    type: 'website',
  },
};

const NPM_ORG_URL = 'https://www.npmjs.com/org/avocadostudio-ai';
const LICENSE_URL = 'https://www.apache.org/licenses/LICENSE-2.0';

// Kept as one @graph so the Organization, WebSite, SoftwareApplication and
// WebPage nodes cross-reference by @id. Everything stated here is also stated
// in visible copy on this page or in the package READMEs on npm — structured
// data that claims more than the page does is what search engines discount.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${SITE.site}/#organization`,
      name: 'Avocado Studio',
      url: SITE.site,
      logo: `${SITE.site}/logo.svg`,
      email: 'hello@avocadostudio.dev',
      sameAs: [...(SHOW_GITHUB_LINKS ? [GITHUB_URL] : []), NPM_ORG_URL, AUTHOR.url],
      founder: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
    },
    {
      '@type': 'WebSite',
      '@id': `${SITE.site}/#website`,
      url: SITE.site,
      name: 'Avocado Studio',
      inLanguage: 'en',
      publisher: { '@id': `${SITE.site}/#organization` },
    },
    {
      '@type': 'SoftwareApplication',
      '@id': `${SITE.site}/#software`,
      name: 'Avocado Studio',
      alternateName: 'Avocado',
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'AI website editor',
      operatingSystem: 'Web',
      softwareRequirements: 'Node.js 22 or later',
      description: DESCRIPTION,
      url: SITE.site,
      image: `${SITE.site}${POSTER_PATH}`,
      screenshot: `${SITE.site}${POSTER_PATH}`,
      downloadUrl: 'https://www.npmjs.com/package/create-avocado-site',
      softwareHelp: { '@type': 'WebSite', name: 'Avocado Studio documentation', url: DOCS_URL },
      license: LICENSE_URL,
      isAccessibleForFree: true,
      sameAs: [PRODUCT_HUNT.url],
      featureList: [
        'Edit website content, images and SEO metadata by describing the change in chat',
        'Click-to-select visual editing in the page preview',
        'Live draft preview in your own site before publishing',
        'Works with Next.js 15 and 16 (App Router) and Astro 5+',
        'Rewrites page titles, meta descriptions and social images for SEO',
        'Publishes to Sanity, Contentful, Strapi or plain JSON files',
        'Bring your own Anthropic, OpenAI or Google Gemini API key',
        'Self-hosted, Apache-2.0 licensed',
        'MCP server for Claude Code, Claude Desktop and other MCP hosts',
      ],
      keywords:
        'AI website editor, visual editor for Next.js, Next.js CMS, Astro CMS, headless CMS AI, AI page builder, AI SEO meta tags, Sanity, Contentful, Strapi, MCP server, open source, self-hosted',
      author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
      publisher: { '@id': `${SITE.site}/#organization` },
      datePublished: PUBLISHED_DATE,
      dateModified: MODIFIED_DATE,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'WebPage',
      '@id': `${SITE.site}/#webpage`,
      url: SITE.site,
      name: TITLE,
      description: DESCRIPTION,
      inLanguage: 'en',
      isPartOf: { '@id': `${SITE.site}/#website` },
      about: { '@id': `${SITE.site}/#software` },
      primaryImageOfPage: { '@type': 'ImageObject', url: `${SITE.site}${POSTER_PATH}`, width: 1280, height: 720 },
      datePublished: PUBLISHED_DATE,
      dateModified: MODIFIED_DATE,
      author: { '@type': 'Person', name: AUTHOR.name, url: AUTHOR.url },
    },
  ],
};
---

<Layout metadata={metadata}>
  <StructuredData slot="head" schema={schema} />

  <!-- Hero ************************ -->

  {/* Hand-built rather than a stock Hero widget so the demo sits beside the
      copy above the fold on desktop, and so the mobile order can be chosen
      deliberately: headline, the one-line promise, the video, and only then
      the actions and small print. A stacked hero pushes the demo a full
      screen down on a phone, which is the one thing it must not do. */}
  {/* Gutters inside the max-w-7xl box, not outside it — `px-4 md:px-6` on the
      container itself, exactly as `WidgetWrapper`, the header and the footer do
      it. With the padding outside, this section's content sat flush against the
      1280px box while everything else on the page was inset 24px inside it: the
      headline and the demo hung a notch further out than the logo above them
      and every section below. Identical below 1328px, where the box is not yet
      capped; visible on every wider screen. */}
  <section class="pt-8 pb-12 sm:pt-12 lg:pt-16 lg:pb-20">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-y-6 px-4 sm:gap-y-8 md:px-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-12 lg:gap-y-8"
    >
      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-1 lg:self-start">
        <h1
          class="display font-heading text-heading text-[2.25rem] leading-[1.08] font-bold tracking-tighter text-balance sm:text-5xl lg:text-[2.875rem] lg:leading-[1.07] xl:text-[3.125rem]"
        >
          Edit, maintain, optimize<br /><span class="text-primary">your website with AI.</span>
        </h1>

        <p class="text-muted mt-4 max-w-xl text-lg leading-8 sm:mt-6">
          Not another way to vibe-code a new site: this runs the one you have. Describe a change and an agent edits
          content, images and SEO in your own components, then publishes to your CMS. Next.js and Astro today.
        </p>

        {/* Whose it is, before anything else. The line above says what it does;
            this says what stays yours, which is the actual pitch. On a phone only
            the four labels show, in a wrapped row, so the video is not pushed a
            screen down; from `sm` each label gets its qualifier. */}
        <ul class="mt-5 flex max-w-xl flex-wrap gap-x-5 gap-y-2 sm:mt-6 sm:grid sm:grid-cols-[max-content_max-content] sm:gap-x-8 sm:gap-y-2">
          {
            [
              ['Your site', 'no migration'],
              ['Your components', 'design system intact'],
              ['Your CMS', 'Sanity, Storyblok & more'],
              ['Your AI keys', 'Claude, GPT or Gemini'],
            ].map(([label, detail]) => (
              <li class="flex items-start gap-2 text-sm leading-6">
                <Icon name="tabler:check" class="text-primary mt-1 h-4 w-4 flex-none" aria-hidden="true" />
                <span>
                  <span class="text-heading font-semibold">{label}</span>
                  <span class="text-muted hidden sm:inline"> — {detail}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div id="demo" class="lg:col-span-6 lg:col-start-7 lg:row-span-2 lg:row-start-1 lg:self-start">
        <figure
          class="border-line bg-sunk overflow-hidden rounded-xl border shadow-[0_1px_2px_rgba(22,36,26,0.05),0_12px_32px_-12px_rgba(22,36,26,0.18)] dark:shadow-none"
        >
          {/* 16/9, matching the recording — the old box was 1280/702 and would
              crop the top and bottom off this one. The ratio is on the wrapper
              so the space is reserved before a single byte of video arrives. */}
          <div class="relative aspect-video w-full">
            {/*
              The demo plays from YouTube, on the Avocado Studio channel, but the
              player is not loaded until someone asks for it. YouTube's embed is
              roughly 700KB of script before its first frame; above the fold that
              would be the heaviest thing on the page. So the page ships only the
              poster and a button, and a click swaps in the player, already
              playing, from the privacy-enhanced youtube-nocookie.com domain.
            */}
            <button
              type="button"
              id="hero-demo"
              data-youtube-id={DEMO_YOUTUBE_ID}
              class="group absolute inset-0 h-full w-full cursor-pointer border-0 bg-transparent p-0"
              aria-label="Play the Avocado Studio demo video"
            >
              <img
                src={POSTER_PATH}
                alt="Avocado Studio: a chat reply beside the rewritten hero of a live page"
                width="1280"
                height="720"
                fetchpriority="high"
                class="absolute inset-0 h-full w-full object-cover"
              />
              <span class="absolute inset-0 flex items-center justify-center">
                <span
                  class="flex h-16 w-16 items-center justify-center rounded-full bg-black/60 backdrop-blur-sm transition-transform duration-150 group-hover:scale-110 group-focus-visible:scale-110"
                >
                  <svg viewBox="0 0 24 24" fill="white" class="ml-1 h-7 w-7" aria-hidden="true"
                    ><path d="M8 5v14l11-7z"></path></svg
                  >
                </span>
              </span>
            </button>
          </div>
        </figure>

        <script is:inline>
          (function () {
            var button = document.getElementById('hero-demo');
            if (!button) return;
            button.addEventListener('click', function () {
              var frame = document.createElement('iframe');
              frame.src =
                'https://www.youtube-nocookie.com/embed/' +
                button.getAttribute('data-youtube-id') +
                '?autoplay=1&playsinline=1&rel=0';
              frame.title = 'Avocado Studio demo';
              frame.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
              frame.allowFullscreen = true;
              frame.referrerPolicy = 'strict-origin-when-cross-origin';
              frame.className = 'absolute inset-0 h-full w-full';
              frame.style.border = '0';
              button.replaceWith(frame);
            });
          })();
        </script>

      </div>

      <div class="lg:col-span-6 lg:col-start-1 lg:row-start-2 lg:self-start">
        <div class="flex flex-wrap items-center gap-3">
          {
            SHOW_GITHUB_LINKS && (
              <Button
                variant="primary"
                href={GITHUB_URL}
                target="_blank"
                rel="noopener"
                icon="tabler:brand-github"
                class="py-2.5 text-[0.9375rem] sm:py-3 sm:text-base"
              >
                View on GitHub
              </Button>
            )
          }
          <Button
            variant={SHOW_GITHUB_LINKS ? 'secondary' : 'primary'}
            href={DEMO_URL}
            target="_blank"
            rel="noopener"
            class="py-2.5 text-[0.9375rem] sm:py-3 sm:text-base"
          >
            Try the live demo
          </Button>
          <Button variant="secondary" href={DOCS_URL} class="py-2.5 text-[0.9375rem] sm:py-3 sm:text-base">
            Read the docs
          </Button>
        </div>

        <p class="text-muted mt-6 max-w-md text-sm leading-6">
          Open source under
          <a
            href="https://www.apache.org/licenses/LICENSE-2.0"
            target="_blank"
            rel="noopener"
            class="text-link decoration-line-strong hover:decoration-primary underline underline-offset-4 transition-colors"
            >Apache-2.0</a
          >: free for commercial use and self-hosting, no sign-up, no seat count. On your own machine it is one
          command:{' '}
          <a href="#quick-start" class="text-link decoration-line-strong hover:decoration-primary font-mono whitespace-nowrap underline underline-offset-4 transition-colors"
            >{INSTALL_COMMAND}</a
          >.
        </p>

      </div>
    </div>
  </section>

  <!-- Capabilities **************** -->

  <Features
    id="capabilities"
    tagline="Capabilities"
    title="A visual AI editor for Next.js and Astro sites."
    subtitle="Avocado Studio is an open-source AI website editor. It adds chat-driven editing, click-to-select visual editing and a live draft preview to the Next.js or Astro site you already run."
    columns={3}
    items={[
      {
        title: 'AI-assisted editing',
        description:
          'Describe the change in chat, or click a block on the page and edit its fields. Agents update real website content: components, metadata, and publishing steps.',
        icon: 'tabler:wand',
      },
      {
        title: 'Live preview',
        description:
          'See changes instantly in your own application while agents modify content and layouts in real time.',
        icon: 'tabler:eye',
      },
      {
        title: 'Works with your stack',
        description:
          'Use your existing CMS, DAM, design system, frontend, and AI providers. No proprietary lock-in.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Multi-model',
        description:
          'Bring your own models from Anthropic, OpenAI, or Gemini for text, images, and multimodal work. Route different tasks to different models.',
        icon: 'tabler:topology-star-3',
      },
      {
        title: 'Self-hostable',
        description: 'Deploy on your own infrastructure with full control over data, APIs, prompts, and integrations.',
        icon: 'tabler:server-2',
      },
      {
        title: 'Connected workflows',
        description: 'Link editing, approvals, publishing, media, and localization into one workflow you control.',
        icon: 'tabler:route',
      },
    ]}
  />

  <!-- How it works **************** -->

  <Steps
    id="how-it-works"
    tagline="How it works"
    title="Describe it. Review it. Ship it."
    subtitle="Nothing reaches production because an agent decided it should. Every change passes through a preview you sign off on."
    items={[
      {
        title: 'Describe the change',
        description: 'Say what you want in plain language — no schema spelunking, no ticket for a one-line copy fix.',
        icon: 'tabler:message-2',
      },
      {
        title: 'Agents do the work',
        description:
          'Content, components, and SEO metadata are updated in place, and media assets are created or edited with GenAI.',
        icon: 'tabler:wand',
      },
      {
        title: 'Preview before anything ships',
        description:
          'See the result in your own application, with your components, schema, and review rules intact.',
        icon: 'tabler:eye-check',
      },
      {
        title: 'Publish on your own terms',
        description:
          'Approvals and publishing run through the pipeline you already have, on infrastructure you control.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <!-- Architecture **************** -->

  <Content
    id="architecture"
    tagline="Architecture"
    title="An open layer between AI and your stack."
    subtitle="Avocado Studio sits between AI models and your existing content systems. Instead of replacing your stack, it coordinates work across it."
    columns={2}
    items={[
      { title: 'Websites' },
      { title: 'Headless CMSs' },
      { title: 'DAMs' },
      { title: 'Design systems' },
      { title: 'Localization tools' },
      { title: 'Publishing pipelines' },
    ]}
  >
    <Fragment slot="image">
      <ArchitectureStack />
    </Fragment>

    <Fragment slot="content">
      <p>Next.js and Astro today, with your own components doing the rendering. Extend to the rest of your stack from there.</p>
    </Fragment>
  </Content>

  <!-- Integrations **************** -->

  {/* The concrete half of the architecture section above: which frameworks,
      content sources, models and agents it plugs into today. Written as prose
      rather than a logo wall — these are the exact pairings people search for
      ("Next.js AI editor", "Sanity AI editing", "MCP server for a CMS"), and
      answer engines quote sentences, not logos. Each claim here matches the
      package READMEs on npm; keep them in step when support changes. */}
  <WidgetWrapper id="integrations">
    <Headline
      tagline="Integrations"
      title="Works with Next.js, Astro and your headless CMS."
      subtitle="No migration and no second copy of your templates: Avocado Studio plugs into your framework, your content source and your AI provider."
      classes={{ container: 'max-w-3xl', title: 'text-3xl md:text-4xl', subtitle: 'text-lg' }}
    />
    <ul class="mx-auto grid max-w-5xl list-none gap-5 md:grid-cols-2">
      {
        [
          {
            icon: 'tabler:brand-nextjs',
            title: 'Next.js and Astro visual editing',
            description:
              'Next.js 15 and 16 on the App Router, where the orchestrator can run inside your own app, so there is no extra service to deploy. Astro 5 and later through an integration that renders your own <code>.astro</code> components: no React islands, nothing ported.',
            link: { text: 'Next.js integration guide', href: `${DOCS_URL}/integration/nextjs-integration` },
          },
          {
            icon: 'tabler:database',
            title: 'Sanity, Contentful, Strapi or plain files',
            description:
              'Starter templates for Sanity, Contentful and Strapi, or a plain JSON file; any other store connects through a content adapter. Publishing writes back only the fields that changed, so references and rich text survive the round trip.',
            link: { text: 'Connecting your site and CMS', href: `${DOCS_URL}/sites` },
          },
          {
            icon: 'tabler:sparkles',
            title: 'Claude, GPT or Gemini',
            description:
              'Bring your own Anthropic, OpenAI or Google Gemini API key. Chat is the only part that needs one: pages, click-to-select and the property panel work without it. Avocado runs on your key and never resells tokens.',
          },
          {
            icon: 'tabler:robot',
            title: 'An MCP server for Claude Code and Cursor',
            description:
              'An MCP server exposes pages, blocks, media and publishing to Claude Code, Claude Desktop and other MCP hosts. Agent skills teach Claude Code, Cursor, Codex and Gemini how to wire Avocado into your site.',
            link: { text: 'The MCP server on npm', href: 'https://www.npmjs.com/package/@avocadostudio-ai/mcp-server' },
          },
        ].map(({ icon, title, description, link }) => (
          <li class="border-line bg-page flex gap-4 rounded-xl border p-6">
            <Icon name={icon} class="text-primary mt-0.5 h-7 w-7 flex-none" aria-hidden="true" />
            <div>
              <h3 class="text-heading text-lg font-semibold">{title}</h3>
              <p class="text-muted mt-2 leading-7" set:html={description} />
              {
                link && (
                  <a
                    href={link.href}
                    class="text-link decoration-line-strong hover:decoration-primary mt-3 inline-block text-sm font-medium underline underline-offset-4 transition-colors"
                  >
                    {link.text}
                  </a>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <!-- Use cases ******************* -->

  {/* Titles are the jobs people search for help with, in their words, not ours. */}
  <Features3
    id="use-cases"
    tagline="Use cases"
    title="What teams use an AI website editor for."
    columns={2}
    items={[
      {
        title: 'Edit your website with AI',
        description:
          'Change website content in plain language while keeping your components, schema, and review rules intact.',
        icon: 'tabler:pencil',
      },
      {
        title: 'Let marketers update the site without a developer',
        description:
          'Once a developer has wired it in, copy fixes, new sections and landing-page changes are a sentence in chat and a preview to approve, not a ticket in a queue.',
        icon: 'tabler:calendar-stats',
      },
      {
        title: 'SEO titles and meta descriptions',
        description:
          'Ask for better page titles, meta descriptions and social images across your pages, and review every one before it publishes.',
        icon: 'tabler:search',
      },
      {
        title: 'AI images next to your copy',
        description:
          'Generate an image, upload one or search Unsplash in the same chat that rewrites the copy, with alt text edited alongside it.',
        icon: 'tabler:photo-edit',
      },
    ]}
  />

  <!-- Developer experience ******** -->

  <WidgetWrapper id="developers">
    <Headline
      tagline="Developer experience"
      title="Built for developers and platform teams."
      classes={{ container: 'max-w-3xl', title: 'text-3xl md:text-4xl' }}
    />
    <ul class="mx-auto grid max-w-5xl gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        [
          'API-first architecture',
          'Git-friendly workflows',
          'Self-hostable deployment',
          'Extensible adapters',
          'Streaming workflows',
          'Bring your own AI providers',
          'Works alongside existing CMS platforms',
          'Open source, Apache-2.0',
          'MCP server for AI agents',
        ].map((item, index) => (
          <li class="border-line text-page flex items-baseline gap-3 border-b py-3 text-sm">
            <span aria-hidden="true" class="label tabular-nums">
              {String(index + 1).padStart(2, '0')}
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </WidgetWrapper>

  <!-- Positioning ***************** -->

  {/* WidgetWrapper's isDark paints bg-dark but turns it transparent in dark mode,
      on the assumption the whole page is already dark. Here the band is a
      deliberate change of ground either way, so give it its own surface: the
      deep brand green on paper, one step lighter than the page in dark. */}
  <WidgetWrapper isDark containerClass="max-w-4xl text-center py-16 md:py-24 lg:py-28">
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-[#16241a] dark:bg-[#1e2519]"></div>
    </Fragment>
    <h2 class="display font-heading text-3xl leading-tight font-bold tracking-tighter text-balance text-white md:text-5xl">
      Not another CMS.<br />Not another AI writing tool.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-7 text-white/75">
      Avocado Studio is an open-source AI layer for editing and publishing across the tools you already use.
    </p>
    <p class="mx-auto mt-4 max-w-xl leading-7 text-white/60">
      It helps teams edit websites and publish content with AI agents while keeping their existing stack,
      infrastructure, and controls intact.
    </p>
  </WidgetWrapper>

  <!-- Quick start ***************** -->

  <QuickStart
    id="quick-start"
    tagline="Run it yourself"
    title="One command to a working editor."
    subtitle="Scaffolds a site, the editor and the AI layer in one project, then starts it with <code>npm run dev</code>."
    commands={[INSTALL_COMMAND]}
    items={[
      { title: 'Node 22+', description: 'The only prerequisite.', icon: 'tabler:server-2' },
      {
        title: 'Your own key',
        description: 'Anthropic, OpenAI or Gemini. Without one the editor still opens; chat asks for a key.',
        icon: 'tabler:plug-connected',
      },
      {
        title: 'Or your own site',
        description:
          'Run the same command inside an existing Next.js app and choose <em>Wire Avocado into this project</em>, or add the Astro integration. <a class="text-link underline" href="https://docs.avocadostudio.dev/sites">See the docs</a>.',
        icon: 'tabler:route',
      },
    ]}
  />

  <!-- FAQs ************************ -->

  {/* Each question is phrased the way people ask it of a search box or an
      assistant, and each answer names the product and stands on its own, so a
      quoted answer still makes sense without the rest of the page. The widget
      emits these as FAQPage structured data. */}
  <FAQs
    id="faqs"
    tagline="FAQs"
    title="Questions about editing a website with AI."
    schema
    items={[
      {
        title: 'What is Avocado Studio?',
        description:
          'Avocado Studio is an open-source AI website editor for Next.js and Astro sites. You describe a change in plain language, an AI agent edits the content, images and SEO metadata in your site’s own components, you review it in a live draft preview, and it publishes to your CMS or content files. It is self-hosted, licensed Apache-2.0, and runs on your own Anthropic, OpenAI or Google Gemini API key.',
      },
      {
        title: 'Is Avocado Studio free and open source?',
        description:
