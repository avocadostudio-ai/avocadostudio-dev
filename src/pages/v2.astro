---
import Layout from '~/layouts/PageLayout.astro';
import Button from '~/components/ui/Button.astro';
import { DOCS_URL, GITHUB_URL, SHOW_GITHUB_LINKS } from '~/site';

// Internal layout variant, not a page we want competing with / in search.
const metadata = {
  title: 'Alternate hero',
  description: 'Internal layout variant of the Avocado Studio homepage. Not indexed.',
  robots: { index: false, follow: false },
};
---

<Layout metadata={metadata}>
  <section class="px-4 py-24 sm:px-6">
    <div class="mx-auto w-full max-w-2xl space-y-8 text-center">
      <p
        class="border-primary/30 bg-primary/10 text-primary inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold tracking-wide sm:text-sm"
      >
        Open-source AI editor &amp; page builder for Next.js
      </p>

      <h1 class="font-heading text-heading display text-4xl leading-tight font-bold tracking-tight sm:text-6xl">
        Open, agentic, composable<br /><span class="text-primary">content operations.</span>
      </h1>

      <p class="text-muted mx-auto max-w-xl text-lg leading-relaxed">
        Bring AI-native editing to any Next.js website. Free and open source, self-hostable, BYO LLM keys, composable
        with the CMS, DAM, and stack you already have.
      </p>

      <div class="flex flex-wrap items-center justify-center gap-3">
        {
          SHOW_GITHUB_LINKS && (
            <Button variant="primary" href={GITHUB_URL} target="_blank" rel="noopener" icon="tabler:brand-github">
              View on GitHub
            </Button>
          )
        }
        <Button variant={SHOW_GITHUB_LINKS ? 'secondary' : 'primary'} href={DOCS_URL}>Read the docs</Button>
      </div>
    </div>
  </section>
</Layout>
